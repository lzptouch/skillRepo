{
  "$description": "W3C DTCG 格式设计令牌。三层：primitive → semantic → component。真实生效的是 tokens.css，本文件是唯一真源。",
  "primitive": {
    "gray":   { "50":  { "$value": "#FAFAF9" }, "100": { "$value": "#F4F4F5" }, "200": { "$value": "#E4E4E7" },
               "300":  { "$value": "#D4D4D8" }, "600": { "$value": "#52525B" }, "700": { "$value": "#A1A1AA" },
               "900":  { "$value": "#18181B" } },
    "brand":  { "500": { "$value": "#4F46E5" }, "600": { "$value": "#4338CA" }, "700": { "$value": "#3730A3" } },
    "red":    { "500": { "$value": "#DC2626" }, "600": { "$value": "#B91C1C" } },
    "green":  { "500": { "$value": "#16A34A" } },
    "amber":  { "500": { "$value": "#D97706" } },
    "space":  { "1": { "$value": "4px" },  "2": { "$value": "8px" },  "3": { "$value": "12px" },
               "4": { "$value": "16px" }, "6": { "$value": "24px" }, "8": { "$value": "32px" },
               "12": { "$value": "48px" } },
    "radius": { "sm": { "$value": "6px" }, "md": { "$value": "8px" }, "lg": { "$value": "12px" } }
  },

  "semantic": {
    "color": {
      "bg": {
        "canvas":  { "$value": "{primitive.gray.50}",  "$description": "页面底色" },
        "surface": { "$value": "#FFFFFF",             "$description": "卡片、面板" },
        "subtle":  { "$value": "{primitive.gray.100}", "$description": "表头、次要分区" }
      },
      "text": {
        "primary":   { "$value": "{primitive.gray.900}" },
        "secondary": { "$value": "{primitive.gray.600}" },
        "muted":     { "$value": "{primitive.gray.700}" },
        "danger":    { "$value": "{primitive.red.600}" }
      },
      "border": {
        "subtle": { "$value": "{primitive.gray.200}" },
        "strong": { "$value": "{primitive.gray.300}" },
        "error":  { "$value": "{primitive.red.500}" }
      },
      "action": {
        "primary":        { "$value": "{primitive.brand.600}", "$description": "仅主 CTA、焦点环、选中态" },
        "primary.hover":  { "$value": "{primitive.brand.700}" }
      },
      "feedback": {
        "success": { "$value": "{primitive.green.500}" },
        "warning": { "$value": "{primitive.amber.500}" },
        "danger":  { "$value": "{primitive.red.500}" }
      }
    },
    "space": {
      "xs": { "$value": "{primitive.space.1}" },
      "sm": { "$value": "{primitive.space.2}" },
      "md": { "$value": "{primitive.space.3}" },
      "lg": { "$value": "{primitive.space.4}" },
      "xl": { "$value": "{primitive.space.6}" }
    },
    "radius": {
      "control": { "$value": "{primitive.radius.sm}", "$description": "按钮、输入框" },
      "card":    { "$value": "{primitive.radius.md}", "$description": "卡片，不超过这个值" }
    }
  },

  "component": {
    "$description": "组件级 token 跟组件同位置，可由 semantic 推导或用 OKLCH 明度delta 计算 hover/active",
    "state": {
      "lDelta": { "hover": { "$value": 0.06 }, "pressed": { "$value": -0.03 } }
    },
    "button": {
      "paddingX": { "sm": { "$value": "{semantic.space.sm}" }, "md": { "$value": "{semantic.space.lg}" } },
      "height":   { "md": { "$value": "36px" } }
    },
    "table": {
      "rowHeight":  { "$value": "44px" },
      "headerBg":   { "$value": "{semantic.color.bg.subtle}" },
      "cellPaddingX": { "$value": "{semantic.space.lg}" }
    },
    "card": {
      "padding": { "$value": "{semantic.space.lg}" },
      "radius":  { "$value": "{semantic.radius.card}" },
      "shadow":  { "$value": "0 1px 2px 0 rgb(0 0 0 / 0.05)" }
    }
  }
}
